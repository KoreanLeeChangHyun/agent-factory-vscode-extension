{
  "name": "agent-factory-main-chat",
  "displayName": "Agent Factory Main Chat",
  "description": "Main Agent chat sessions in VS Code editor tabs.",
  "version": "1.0.9",
  "publisher": "agent-factory",
  "icon": "static/images/agent-factory.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:agentFactory.mainChat.open",
    "onCommand:agentFactory.mainChat.resume",
    "onCommand:agentFactory.mainChat.rename",
    "onCommand:agentFactory.loadingAnimations.preview",
    "onWebviewPanel:agentFactory.mainChat",
    "onView:agentFactory.agents"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentFactory.mainChat.open",
        "title": "Add Main Agent Chat",
        "category": "Agent Factory",
        "icon": "$(add)"
      },
      {
        "command": "agentFactory.mainChat.resume",
        "title": "Agent Factory: Resume Main Agent",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.mainChat.rename",
        "title": "Rename Main Agent",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.loadingAnimations.preview",
        "title": "Preview Loading Animations",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.sidebar.refresh",
        "title": "Refresh Agents",
        "category": "Agent Factory",
        "icon": "$(refresh)"
      },
      {
        "command": "agentFactory.sidebar.open",
        "title": "Open Agent",
        "category": "Agent Factory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentFactory.sidebar.rename",
        "title": "Rename Agent",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.newGroup",
        "title": "New Agent Group",
        "category": "Agent Factory",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentFactory.sidebar.move",
        "title": "Move Agent to Group",
        "category": "Agent Factory",
        "icon": "$(folder)"
      },
      {
        "command": "agentFactory.sidebar.renameGroup",
        "title": "Rename Group",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.deleteGroup",
        "title": "Ungroup",
        "category": "Agent Factory",
        "icon": "$(ungroup-by-ref-type)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentFactory.mainChat.open",
          "group": "0_new@3"
        },
        {
          "command": "agentFactory.mainChat.rename",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "2_workspace@1"
        }
      ],
      "view/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "view == agentFactory.agents",
          "group": "navigation@1"
        },
        {
          "command": "agentFactory.sidebar.newGroup",
          "when": "view == agentFactory.agents",
          "group": "navigation@2"
        },
        {
          "command": "agentFactory.sidebar.refresh",
          "when": "view == agentFactory.agents",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentFactory.sidebar.rename",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.move",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "organization@1"
        },
        {
          "command": "agentFactory.sidebar.renameGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.deleteGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "organization@1"
        }
      ]
    },
    "configuration": {
      "title": "Agent Factory Main Chat",
      "properties": {
        "agentFactory.mainChat.statusItems": {
          "type": "array",
          "scope": "window",
          "default": [
            "status",
            "agents",
            "project",
            "branch",
            "context",
            "queue"
          ],
          "items": {
            "type": "string",
            "enum": [
              "agent",
              "status",
              "agents",
              "project",
              "branch",
              "context",
              "elapsed",
              "queue",
              "runtime",
              "role",
              "model",
              "reasoning",
              "fast",
              "goal",
              "task",
              "execution",
              "contextUsed",
              "contextRemainingTokens",
              "contextUsedPercent",
              "contextWindow",
              "weekly",
              "weeklyRemaining",
              "agentsTotal",
              "goalTokens",
              "goalTime",
              "goalBudget"
            ]
          },
          "description": "Choose which information to display and its order in the status bar settings below the chat. Drag items or use the move buttons to reorder them. An empty array hides all items.",
          "uniqueItems": true
        },
        "agentFactory.mainChat.pythonPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Python 3.10+ executable path on the extension host (without shell arguments). Empty uses python3 from PATH. On macOS, select your installed Python if the system Python is older."
        },
        "agentFactory.mainChat.runtimeExecPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Optional absolute path to the installed Agent Factory skills/agent/scripts/exec.py. When empty, the extension searches CODEX_HOME or ~/.codex plugin cache."
        },
        "agentFactory.mainChat.executionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "cli-default",
            "workspace-write",
            "danger-full-access",
            "bypass"
          ],
          "default": "danger-full-access",
          "enumDescriptions": [
            "New sessions use CLI settings; existing sessions keep their saved policy.",
            "Allow workspace writes without requesting additional approval during execution.",
            "Allow full file system and network access without requesting additional approval during execution.",
            "Allow full access and proceed without execution approval or plan reapproval."
          ],
          "description": "Permissions for the next Main Agent run. The default allows full file system and network access without additional execution approval. You can restrict access to workspace writes or CLI defaults. Permissions can change between runs in the same session; the current run is unaffected."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFactory",
          "title": "Agent Factory",
          "icon": "static/images/agent-factory-activity.svg"
        }
      ]
    },
    "views": {
      "agentFactory": [
        {
          "id": "agentFactory.agents",
          "name": "Agents"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm run check:static && npm run test && npm run build",
    "check:static": "node --check static/js/chat.js && node --check static/js/ansi-renderer.js && node --check static/js/execution-references.js && node --check static/js/loading-animation-gallery.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "package": "npm run check && node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\" && node --require ./scripts/node-file-polyfill.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository --out releases",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/plist": "^3.0.5",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "markdown-it": "^14.3.1",
    "plist": "^5.0.0",
    "shiki": "^4.4.3"
  }
}
