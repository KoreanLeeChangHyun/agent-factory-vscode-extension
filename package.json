{
  "name": "agent-factory-main-chat",
  "displayName": "Agent Factory Main Chat",
  "description": "%extension.description%",
  "version": "1.0.14",
  "publisher": "agent-factory",
  "icon": "static/images/agent-factory.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:agentFactory.mainChat.open",
    "onCommand:agentFactory.mainChat.resume",
    "onCommand:agentFactory.mainChat.rename",
    "onCommand:agentFactory.mainChat.clearConversation",
    "onCommand:agentFactory.loadingAnimations.preview",
    "onWebviewPanel:agentFactory.mainChat",
    "onView:agentFactory.agents"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentFactory.mainChat.open",
        "title": "%agentFactory.mainChat.open.title%",
        "category": "Agent Factory",
        "icon": "$(add)"
      },
      {
        "command": "agentFactory.mainChat.resume",
        "title": "%agentFactory.mainChat.resume.title%",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.mainChat.rename",
        "title": "%agentFactory.mainChat.rename.title%",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.mainChat.clearConversation",
        "title": "%agentFactory.mainChat.clearConversation.title%",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.loadingAnimations.preview",
        "title": "%agentFactory.loadingAnimations.preview.title%",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.sidebar.refresh",
        "title": "%agentFactory.sidebar.refresh.title%",
        "category": "Agent Factory",
        "icon": "$(refresh)"
      },
      {
        "command": "agentFactory.sidebar.open",
        "title": "%agentFactory.sidebar.open.title%",
        "category": "Agent Factory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentFactory.sidebar.rename",
        "title": "%agentFactory.sidebar.rename.title%",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.newGroup",
        "title": "%agentFactory.sidebar.newGroup.title%",
        "category": "Agent Factory",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentFactory.sidebar.move",
        "title": "%agentFactory.sidebar.move.title%",
        "category": "Agent Factory",
        "icon": "$(folder)"
      },
      {
        "command": "agentFactory.sidebar.renameGroup",
        "title": "%agentFactory.sidebar.renameGroup.title%",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.deleteGroup",
        "title": "%agentFactory.sidebar.deleteGroup.title%",
        "category": "Agent Factory",
        "icon": "$(ungroup-by-ref-type)"
      },
      {
        "command": "agentFactory.sidebar.archive",
        "title": "%agentFactory.sidebar.archive.title%",
        "category": "Agent Factory",
        "icon": "$(archive)"
      },
      {
        "command": "agentFactory.sidebar.restore",
        "title": "%agentFactory.sidebar.restore.title%",
        "category": "Agent Factory",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentFactory.mainChat.open",
          "group": "0_new@3"
        },
        {
          "command": "agentFactory.mainChat.rename",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "2_workspace@1"
        },
        {
          "command": "agentFactory.mainChat.clearConversation",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "2_workspace@2"
        }
      ],
      "view/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "view == agentFactory.agents",
          "group": "navigation@1"
        },
        {
          "command": "agentFactory.sidebar.newGroup",
          "when": "view == agentFactory.agents",
          "group": "navigation@2"
        },
        {
          "command": "agentFactory.sidebar.refresh",
          "when": "view == agentFactory.agents",
          "group": "navigation@3"
        },
        {
          "command": "agentFactory.sidebar.restore",
          "when": "view == agentFactory.agents",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agentFactory.sidebar.rename",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.move",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "organization@1"
        },
        {
          "command": "agentFactory.sidebar.renameGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.deleteGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "organization@1"
        },
        {
          "command": "agentFactory.sidebar.archive",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "organization@2"
        }
      ]
    },
    "configuration": {
      "title": "Agent Factory Main Chat",
      "properties": {
        "agentFactory.mainChat.statusItems": {
          "type": "array",
          "scope": "window",
          "default": [
            "status",
            "agents",
            "project",
            "branch",
            "context",
            "queue"
          ],
          "items": {
            "type": "string",
            "enum": [
              "agent",
              "status",
              "agents",
              "project",
              "branch",
              "context",
              "elapsed",
              "queue",
              "runtime",
              "role",
              "model",
              "reasoning",
              "fast",
              "goal",
              "task",
              "execution",
              "contextUsed",
              "contextRemainingTokens",
              "contextUsedPercent",
              "contextWindow",
              "weekly",
              "weeklyRemaining",
              "agentsTotal",
              "goalTokens",
              "goalTime",
              "goalBudget"
            ]
          },
          "description": "%agentFactory.mainChat.statusItems.description%",
          "uniqueItems": true
        },
        "agentFactory.mainChat.pythonPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "%agentFactory.mainChat.pythonPath.description%"
        },
        "agentFactory.mainChat.codexPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "%agentFactory.mainChat.codexPath.description%"
        },
        "agentFactory.mainChat.claudePath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "%agentFactory.mainChat.claudePath.description%"
        },
        "agentFactory.mainChat.runtimeExecPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "%agentFactory.mainChat.runtimeExecPath.description%"
        },
        "agentFactory.mainChat.executionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "cli-default",
            "workspace-write",
            "danger-full-access",
            "bypass"
          ],
          "default": "danger-full-access",
          "enumDescriptions": [
            "%agentFactory.mainChat.executionMode.enum.0%",
            "%agentFactory.mainChat.executionMode.enum.1%",
            "%agentFactory.mainChat.executionMode.enum.2%",
            "%agentFactory.mainChat.executionMode.enum.3%"
          ],
          "description": "%agentFactory.mainChat.executionMode.description%"
        },
        "agentFactory.mainChat.botPrompt": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multilineText",
          "description": "%agentFactory.mainChat.botPrompt.description%"
        },
        "agentFactory.mainChat.botsEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%agentFactory.mainChat.botsEnabled.description%"
        },
        "agentFactory.agents.main.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.main.model.description%",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$"
        },
        "agentFactory.agents.main.reasoningEffort": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.main.reasoningEffort.description%",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "agentFactory.agents.work.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.work.model.description%",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$"
        },
        "agentFactory.agents.work.reasoningEffort": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.work.reasoningEffort.description%",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "agentFactory.agents.verification.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.verification.model.description%",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$"
        },
        "agentFactory.agents.verification.reasoningEffort": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%agentFactory.agents.verification.reasoningEffort.description%",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFactory",
          "title": "Agent Factory",
          "icon": "static/images/agent-factory-activity.svg"
        }
      ]
    },
    "views": {
      "agentFactory": [
        {
          "id": "agentFactory.agents",
          "name": "%agentFactory.agents.name%"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm run check:static && npm run test && npm run build",
    "check:static": "node --check static/js/localization.js && node --check static/js/chat.js && node --check static/js/contracts.js && node --check static/js/ansi-renderer.js && node --check static/js/execution-references.js && node --check static/js/loading-animation-gallery.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "package": "npm run check && node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\" && node --require ./scripts/node-file-polyfill.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository --out releases",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/plist": "^3.0.5",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "markdown-it": "^14.3.1",
    "plist": "^5.0.0",
    "shiki": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KoreanLeeChangHyun/agent-factory-vscode-extension.git"
  }
}
