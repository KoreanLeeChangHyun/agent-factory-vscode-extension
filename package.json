{
  "name": "agent-factory-main-chat",
  "displayName": "Agent Factory Main Chat",
  "description": "Main Agent chat sessions in VS Code editor tabs.",
  "version": "0.1.1",
  "publisher": "agent-factory",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:agentFactory.mainChat.open",
    "onCommand:agentFactory.mainChat.resume",
    "onCommand:agentFactory.mainChat.rename",
    "onWebviewPanel:agentFactory.mainChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentFactory.mainChat.open",
        "title": "Main Agent 채팅 추가",
        "category": "Agent Factory",
        "icon": "$(add)"
      },
      {
        "command": "agentFactory.mainChat.resume",
        "title": "Agent Factory: Resume Main Agent",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.mainChat.rename",
        "title": "Main Agent 이름 변경",
        "category": "Agent Factory"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentFactory.mainChat.open",
          "group": "0_new@3"
        },
        {
          "command": "agentFactory.mainChat.rename",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "2_workspace@1"
        }
      ]
    },
    "configuration": {
      "title": "Agent Factory Main Chat",
      "properties": {
        "agentFactory.mainChat.statusItems": {
          "type": "array",
          "scope": "window",
          "default": [
            "status",
            "agents",
            "project",
            "branch",
            "context",
            "queue"
          ],
          "items": {
            "type": "string",
            "enum": [
              "agent",
              "status",
              "agents",
              "project",
              "branch",
              "context",
              "elapsed",
              "queue",
              "runtime"
            ]
          },
          "description": "Items displayed in the chat status bar, in display order."
        },
        "agentFactory.mainChat.runtimeExecPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Optional absolute path to the installed Agent Factory skills/agent/scripts/exec.py. When empty, the extension searches CODEX_HOME or ~/.codex plugin cache."
        },
        "agentFactory.mainChat.executionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "cli-default",
            "workspace-write",
            "danger-full-access",
            "bypass"
          ],
          "default": "danger-full-access",
          "enumDescriptions": [
            "CLI 설정을 그대로 사용합니다.",
            "작업 공간 쓰기를 허용하며 실행 중 추가 승인은 요청하지 않습니다.",
            "전체 파일 시스템과 네트워크 접근을 허용하며 실행 중 추가 승인은 요청하지 않습니다.",
            "샌드박스·실행 승인 없음. 전체 접근과 동일한 실행 정책입니다."
          ],
          "description": "새 Main Agent 채팅의 실행 권한입니다. 기본값은 전체 파일 시스템과 네트워크 접근을 허용하고 추가 실행 승인을 요청하지 않습니다. 작업 공간 쓰기 또는 CLI 기본값으로 제한할 수 있습니다. 이미 시작한 세션의 권한은 변경되지 않으며 새 채팅이 필요합니다."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm run check:static && npm run test && npm run build",
    "check:static": "node --check static/js/chat.js && node --check static/js/ansi-renderer.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "package": "npm run check && node --require ./scripts/node-file-polyfill.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/plist": "^3.0.5",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "markdown-it": "^14.3.1",
    "plist": "^5.0.0",
    "shiki": "^4.4.3"
  }
}
