{
  "name": "agent-factory-main-chat",
  "displayName": "Agent Factory Main Chat",
  "description": "Main Agent chat sessions in VS Code editor tabs.",
  "version": "1.0.3",
  "publisher": "agent-factory",
  "icon": "static/images/agent-factory.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:agentFactory.mainChat.open",
    "onCommand:agentFactory.mainChat.resume",
    "onCommand:agentFactory.mainChat.rename",
    "onCommand:agentFactory.loadingAnimations.preview",
    "onWebviewPanel:agentFactory.mainChat",
    "onView:agentFactory.agents"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentFactory.mainChat.open",
        "title": "Main Agent 채팅 추가",
        "category": "Agent Factory",
        "icon": "$(add)"
      },
      {
        "command": "agentFactory.mainChat.resume",
        "title": "Agent Factory: Resume Main Agent",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.mainChat.rename",
        "title": "Main Agent 이름 변경",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.loadingAnimations.preview",
        "title": "로딩 애니메이션 샘플 보기",
        "category": "Agent Factory"
      },
      {
        "command": "agentFactory.sidebar.refresh",
        "title": "에이전트 목록 새로고침",
        "category": "Agent Factory",
        "icon": "$(refresh)"
      },
      {
        "command": "agentFactory.sidebar.open",
        "title": "에이전트 열기",
        "category": "Agent Factory",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentFactory.sidebar.rename",
        "title": "에이전트 이름 변경",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.newGroup",
        "title": "새 에이전트 그룹",
        "category": "Agent Factory",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentFactory.sidebar.move",
        "title": "에이전트 그룹 변경",
        "category": "Agent Factory",
        "icon": "$(folder)"
      },
      {
        "command": "agentFactory.sidebar.renameGroup",
        "title": "그룹 이름 변경",
        "category": "Agent Factory",
        "icon": "$(edit)"
      },
      {
        "command": "agentFactory.sidebar.deleteGroup",
        "title": "그룹 해제",
        "category": "Agent Factory",
        "icon": "$(ungroup-by-ref-type)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentFactory.mainChat.open",
          "group": "0_new@3"
        },
        {
          "command": "agentFactory.mainChat.rename",
          "when": "activeWebviewPanelId == agentFactory.mainChat",
          "group": "2_workspace@1"
        }
      ],
      "view/title": [
        {
          "command": "agentFactory.mainChat.open",
          "when": "view == agentFactory.agents",
          "group": "navigation@1"
        },
        {
          "command": "agentFactory.sidebar.newGroup",
          "when": "view == agentFactory.agents",
          "group": "navigation@2"
        },
        {
          "command": "agentFactory.sidebar.refresh",
          "when": "view == agentFactory.agents",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentFactory.sidebar.rename",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.move",
          "when": "view == agentFactory.agents && viewItem == agentFactoryAgent",
          "group": "organization@1"
        },
        {
          "command": "agentFactory.sidebar.renameGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "inline@1"
        },
        {
          "command": "agentFactory.sidebar.deleteGroup",
          "when": "view == agentFactory.agents && viewItem == agentFactoryGroup",
          "group": "organization@1"
        }
      ]
    },
    "configuration": {
      "title": "Agent Factory Main Chat",
      "properties": {
        "agentFactory.mainChat.statusItems": {
          "type": "array",
          "scope": "window",
          "default": [
            "status",
            "agents",
            "project",
            "branch",
            "context",
            "queue"
          ],
          "items": {
            "type": "string",
            "enum": [
              "agent",
              "status",
              "agents",
              "project",
              "branch",
              "context",
              "elapsed",
              "queue",
              "runtime"
            ]
          },
          "description": "Items displayed in the chat status bar, in display order."
        },
        "agentFactory.mainChat.runtimeExecPath": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Optional absolute path to the installed Agent Factory skills/agent/scripts/exec.py. When empty, the extension searches CODEX_HOME or ~/.codex plugin cache."
        },
        "agentFactory.mainChat.executionMode": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "cli-default",
            "workspace-write",
            "danger-full-access",
            "bypass"
          ],
          "default": "danger-full-access",
          "enumDescriptions": [
            "새 세션은 CLI 설정을 사용하며 기존 세션은 저장된 정책을 유지합니다.",
            "작업 공간 쓰기를 허용하며 실행 중 추가 승인은 요청하지 않습니다.",
            "전체 파일 시스템과 네트워크 접근을 허용하며 실행 중 추가 승인은 요청하지 않습니다.",
            "전체 접근을 허용하며 실행 승인과 계획 재승인 없이 바로 진행합니다."
          ],
          "description": "Main Agent의 다음 실행에 적용할 권한입니다. 기본값은 전체 파일 시스템과 네트워크 접근을 허용하고 추가 실행 승인을 요청하지 않습니다. 작업 공간 쓰기 또는 CLI 기본값으로 제한할 수 있습니다. 같은 세션에서도 실행 사이에 변경할 수 있으며 현재 실행 중인 작업은 변경하지 않습니다."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFactory",
          "title": "Agent Factory",
          "icon": "static/images/agent-factory-activity.svg"
        }
      ]
    },
    "views": {
      "agentFactory": [
        {
          "id": "agentFactory.agents",
          "name": "에이전트"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run typecheck && npm run check:static && npm run test && npm run build",
    "check:static": "node --check static/js/chat.js && node --check static/js/ansi-renderer.js && node --check static/js/execution-references.js && node --check static/js/loading-animation-gallery.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "package": "npm run check && node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\" && node --require ./scripts/node-file-polyfill.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository --out releases",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/plist": "^3.0.5",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "markdown-it": "^14.3.1",
    "plist": "^5.0.0",
    "shiki": "^4.4.3"
  }
}
