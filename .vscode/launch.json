{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent Factory: Workspace + Agents",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}/agents",
        "--new-window",
        "${workspaceFolder}"
      ]
    }
  ]
}
