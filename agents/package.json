{
  "name": "agent-factory-agents",
  "displayName": "Agent Factory Agents",
  "description": "Open Agent Factory tools and run bundled Codex agent sessions in the VS Code editor area.",
  "version": "0.0.1",
  "publisher": "agent-factory",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:agentFactoryAgents.launcher",
    "onCommand:agentFactoryAgents.open"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFactoryAgents",
          "title": "Agent Factory",
          "icon": "media/agent-factory.svg"
        }
      ]
    },
    "views": {
      "agentFactoryAgents": [
        {
          "id": "agentFactoryAgents.launcher",
          "name": "Agent Factory"
        }
      ]
    },
    "commands": [
      {
        "command": "agentFactoryAgents.open",
        "title": "Agent Factory: Open Agents"
      }
    ],
    "viewsWelcome": [
      {
        "view": "agentFactoryAgents.launcher",
        "contents": "Open Agent Factory tools in the editor area.\n[Open Agents](command:agentFactoryAgents.open)\n[Open Workspace](command:agentFactoryWorkspace.open)"
      }
    ]
  },
  "scripts": {
    "check": "npm run check:syntax && npm run test:unit && npm run test:integration",
    "check:syntax": "node --check src/extension.js && node --check src/launcher.js && node --check src/agentsPanel.js && node --check src/chatView.js && node --check src/chatBackend.js && node --check src/codexAdapter.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node ./test/runTest.js",
    "prepackage:linux-x64": "node ./scripts/ensureDist.js",
    "package:linux-x64": "vsce package --allow-missing-repository --target linux-x64 --out dist/agent-factory-agents-linux-x64.vsix",
    "verify:vsix": "node ./scripts/verifyVsix.js"
  },
  "dependencies": {
    "@openai/codex-linux-x64": "npm:@openai/codex@0.145.0-linux-x64"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@vscode/test-electron": "3.1.0"
  }
}
