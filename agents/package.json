{
  "name": "agent-factory-agents",
  "displayName": "Agent Factory Agents",
  "description": "Run bundled Codex agent sessions from the VS Code sidebar.",
  "version": "0.0.1",
  "publisher": "agent-factory",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:agentFactoryAgents.explorer",
    "onView:agentFactoryAgents.chat"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFactoryAgents",
          "title": "Agent Factory",
          "icon": "media/agent-factory.svg"
        }
      ]
    },
    "views": {
      "agentFactoryAgents": [
        {
          "id": "agentFactoryAgents.explorer",
          "name": "Explorer"
        },
        {
          "id": "agentFactoryAgents.chat",
          "name": "Agents",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "check": "npm run check:syntax && npm run test:unit && npm run test:integration",
    "check:syntax": "node --check src/extension.js && node --check src/explorerModel.js && node --check src/explorerTree.js && node --check src/chatView.js && node --check src/chatBackend.js && node --check src/codexAdapter.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node ./test/runTest.js",
    "prepackage:linux-x64": "node ./scripts/ensureDist.js",
    "package:linux-x64": "vsce package --allow-missing-repository --target linux-x64 --out dist/agent-factory-agents-linux-x64.vsix",
    "verify:vsix": "node ./scripts/verifyVsix.js"
  },
  "dependencies": {
    "@openai/codex-linux-x64": "npm:@openai/codex@0.145.0-linux-x64"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@vscode/test-electron": "3.1.0"
  }
}
